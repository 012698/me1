# ============================================================
# LENG_MING 社交网站后端环境变量配置（PostgreSQL 版）
# 复制本文件为 .env 后填入实际值
# ============================================================

# ---- 必填：Aiven PostgreSQL 连接串 ----
# 格式示例：postgres://username:password@host:port/defaultdb?sslmode=require
# 从 Aiven Console → 数据库服务 → Connection Information 中获取
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/defaultdb?sslmode=require

# ---- PostgreSQL SSL（Aiven 默认需要 SSL） ----
# true = 连接时使用 SSL（默认），false = 不使用 SSL（仅本地测试用）
PG_SSL=true

# ---- 服务端口 ----
PORT=3000

# ---- JWT 签名密钥（生产环境请务必更换为随机字符串） ----
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- 管理员密码 ----
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE
